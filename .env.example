# --- Base de données ---
# URL Postgres (Railway, Render, Neon, Supabase fournissent tous une base gratuite)
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Authentification ---
# Chaîne aléatoire longue, ex: openssl rand -hex 32
JWT_SECRET=change-moi-en-production

# --- Claude / Anthropic ---
# Clé API réelle depuis console.anthropic.com — le proxy /api/generate l'utilise
# pour appeler Claude au nom de tes utilisateurs (le frontend ne voit jamais cette clé).
ANTHROPIC_API_KEY=sk-ant-...

# --- Chariow ---
# Clé secrète API Chariow (Bearer sk_live_...), utilisée pour vérifier des ventes si besoin.
CHARIOW_API_KEY=sk_live_...
# Secret partagé du Pulse (webhook) que tu configures dans le tableau de bord Chariow.
# Vérifie le nom exact de l'en-tête de signature dans les paramètres de ton Pulse
# (souvent nommé "secret" ou "signing secret") et ajuste WEBHOOK_SIGNATURE_HEADER si besoin.
CHARIOW_WEBHOOK_SECRET=change-moi
WEBHOOK_SIGNATURE_HEADER=x-chariow-signature

# --- Abonnement ---
# Durée en jours d'un cycle Pro payé (30 = mensuel, 365 = annuel).
# Si tu vends les deux, distingue-les via le champ "product_id" ou "amount" du webhook (voir webhooks.js).
PRO_CYCLE_DAYS=30

# --- Quota gratuit ---
FREE_MONTHLY_QUOTA=15

# --- Serveur ---
PORT=3000
# Domaine(s) autorisés à appeler cette API (ton frontend déployé)
CORS_ORIGIN=*
